# =============================================================================
# Backend .env.example
# Copy to backend/.env and fill in your local values.
# NEVER commit backend/.env to version control.
# =============================================================================

# Application
ENVIRONMENT=development
APP_VERSION=0.1.0
SECRET_KEY=change-me-to-a-long-random-secret-key

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://pguser:changeme@localhost:5432/pune_water_network

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
