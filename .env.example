# =============================================================================
# Pune Water Network AI — Root .env.example
# Copy this file to .env and fill in your local values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
ENVIRONMENT=development           # development | staging | production

# ---------------------------------------------------------------------------
# PostgreSQL / PostGIS (used by docker-compose for local development)
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pune_water_network
POSTGRES_USER=pguser
POSTGRES_PASSWORD=changeme

# Full connection URL (alternative to individual vars above)
DATABASE_URL=postgresql+asyncpg://pguser:changeme@localhost:5432/pune_water_network

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-long-random-secret-key
ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Frontend (Vite / React)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------------
# Dataset paths (optional; set if loading local data files)
# ---------------------------------------------------------------------------
# RAW_DATA_DIR=./data/raw
# PROCESSED_DATA_DIR=./data/processed
# SYNTHETIC_DATA_DIR=./data/synthetic
