# =============================================================================
# Pune Water Network AI — .gitattributes
# Enforce consistent line endings and binary classification.
# =============================================================================

# Default: normalise all text files to LF in the repository.
* text=auto eol=lf

# Windows batch/PowerShell scripts use CRLF on checkout
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Source code — always LF
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf
*.md    text eol=lf
*.rst   text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf
Makefile text eol=lf

# Config files
.gitignore     text eol=lf
.gitattributes text eol=lf
.editorconfig  text eol=lf

# Binary files — never diff/merge as text
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text eol=lf
*.pdf   binary
*.zip   binary
*.tar   binary
*.gz    binary
*.pkl   binary
*.pt    binary
*.pth   binary
*.h5    binary
*.onnx  binary
*.shp   binary
*.tif   binary
*.tiff  binary
